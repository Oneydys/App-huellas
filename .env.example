# Huellas: variables de entorno del kit de backend.
# Copia este archivo a .env.local y completa los valores con TUS claves.
# No subas .env.local a git. Sin estas variables, la app sigue en demo y el webhook responde 503.
# npm run dev lee .env.local. npm test y npm run verificar no: define esas variables en la terminal.
# Consulta GUIA-PARA-COMPRADORES.md, sección "Conexiones".

# Supabase (proyecto de desarrollo primero, luego producción)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave de servicio: solo servidor. Nunca la pongas con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart: token del webhook que define tu cuenta de Hotmart
HOTMART_HOTTOK=

# Solo para las pruebas RLS (lib/backend/rls.test.ts): dos cuentas de PRUEBA, nunca reales
PRUEBA_RLS_CORREO_A=
PRUEBA_RLS_CLAVE_A=
PRUEBA_RLS_CORREO_B=
PRUEBA_RLS_CLAVE_B=
